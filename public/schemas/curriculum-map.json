{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://getflourish.co.uk/schemas/curriculum-map.json",
  "title": "CurriculumMap",
  "type": "object",
  "required": ["version", "lessons"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/CurriculumLesson" }
    }
  },
  "$defs": {
    "CurriculumLesson": {
      "type": "object",
      "required": ["lessonId", "title", "tags", "dependencies", "estimatedMinutes", "free"],
      "additionalProperties": false,
      "properties": {
        "lessonId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ISAs",
              "ETFs",
              "Equities",
              "Bonds",
              "Pensions",
              "Tax",
              "Compound Interest",
              "Diversification",
              "Fundamentals"
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "free": {
          "type": "boolean"
        },
        "courseSlug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    }
  }
}
